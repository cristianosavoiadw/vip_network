# Copy to .env_dev (local) or .env_prod (VIP_ENV=prod). Never commit those two.
VIP_ENV=dev
VIP_PORT=3399
VIP_DATABASE_URL=postgresql+asyncpg://vip:vip@localhost:5439/vip
VIP_REDIS_URL=redis://localhost:6382/0
VIP_JWT_SECRET=change-me-to-a-random-string-with-at-least-32-chars
VIP_COOKIE_SECURE=false
VIP_CORS_ORIGINS=http://localhost:3400
VIP_FRONTEND_URL=http://localhost:3400
VIP_FERNET_KEY=

# E-mail: empty provider = log only
VIP_EMAIL_PROVIDER=
VIP_EMAIL_FROM=VIP Network <nao-responda@vipnetwork.com.br>
VIP_EMAIL_REPLY_TO=contato@vipnetwork.com.br
VIP_EMAIL_SMTP_HOST=
VIP_EMAIL_SMTP_PORT=465
VIP_EMAIL_SMTP_SECURITY=ssl
VIP_EMAIL_SMTP_USER=
VIP_EMAIL_SMTP_PASSWORD=

# Stripe: empty key = no real charge (dev, tests)
VIP_STRIPE_SECRET_KEY=
VIP_STRIPE_WEBHOOK_SECRET=
VIP_STRIPE_PRICE_MONTHLY=
VIP_STRIPE_PRICE_ANNUAL=

# CNPJ lookup (AIware Receita base, then CNPJá)
VIP_CNPJ_PROVIDERS=aiware,cnpja
VIP_AIWARE_API_URL=
VIP_AIWARE_API_TOKEN=

# WeOS agents: empty token = local matching
VIP_WEOS_API_URL=https://api-weos.wegen-ai.com/api/v2/public
VIP_WEOS_API_TOKEN=
VIP_WEOS_WORKSPACE_ID=

# Object storage (MinIO): bucket vip, keys <empresa>/<tipo>/<arquivo>
VIP_S3_ENDPOINT=http://localhost:9008
VIP_S3_ACCESS_KEY=vip
VIP_S3_SECRET_KEY=vip-storage-dev
VIP_S3_BUCKET=vip
